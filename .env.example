# Aplicação multi-tenant: PostgreSQL obrigatório, um contexto privado por usuário.
DATABASE_URL=postgresql://agentflows:senha@localhost:5436/agentflows
APP_URL=http://localhost:3000
CHAVE_MESTRA=                    # obrigatória: 32 bytes em base64; igual no web/worker
DATA_DIR=./data                  # arquivos privados; compartilhado pelo web/worker
REDIS_URL=redis://:senha@localhost:6389
RESEND_API_KEY=
RESEND_FROM=Build Agentflows <conta@example.com>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Callback Google: APP_URL/api/auth/google/callback
# TRUSTED_CLIENT_IP_HEADER=      # somente se o proxy sobrescrever esse cabeçalho
# POSTGRES_PASSWORD=            # Compose: senha exclusiva em base64url
# REDIS_PASSWORD=               # Compose: outra senha em base64url
# Credenciais de IA e ferramentas são cadastradas por usuário na aplicação.
